<?xml version="1.0"?>
<!--
  PHPUnit 9.6 configuration. The tests run inside a CiviCRM site (a DDEV site,
  or the shared CI workflow): they need the CiviCRM test listener and a
  headless test database, so they cannot run on a bare host.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/phpunit/bootstrap.php"
         backupGlobals="false"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false">
  <testsuites>
    <testsuite name="headless">
      <directory>tests/phpunit/Headless</directory>
    </testsuite>
  </testsuites>
  <coverage processUncoveredFiles="true">
    <include>
      <file>scheduledccrecipients.php</file>
      <directory suffix=".php">CRM</directory>
    </include>
  </coverage>
  <listeners>
    <listener class="Civi\Test\CiviTestListener">
      <arguments/>
    </listener>
  </listeners>
</phpunit>
